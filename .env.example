POSTGRES_DB=supplier_invoice
POSTGRES_USER=supplier_invoice
# Replace this placeholder with a strong local-only password in your .env file.
POSTGRES_PASSWORD=replace-with-a-strong-local-password

# Public identifiers used only by the explicit Step 4.3 operator command.
# Copy the region and user-pool ID from your intended Cognito pool. No AWS keys.
# Existing API startup does not require these yet; bootstrap validates them.
COGNITO_REGION=replace-with-cognito-region
COGNITO_USER_POOL_ID=replace-with-cognito-user-pool-id
